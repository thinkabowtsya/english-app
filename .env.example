# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN commit .env.local dan JANGAN gunakan prefix NEXT_PUBLIC_ untuk secret.

# Supabase (Project Settings → API Keys). Publishable key aman di browser karena semua
# tabel memakai Row Level Security. JANGAN isi secret/service-role key di sini.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# API key Groq — hanya dibaca di server (Route Handlers).
GROQ_API_KEY=

# Opsional. Default: https://api.groq.com/openai/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Opsional. Model chat Groq. Default: openai/gpt-oss-120b
GROQ_MODEL=

# Opsional. "mock" memaksa AI Coach memakai respons tiruan walaupun API key tersedia.
# Kosongkan atau isi "groq" untuk memakai Groq bila GROQ_API_KEY tersedia.
AI_PROVIDER=
